# A&B Chemist frontend — environment variables.
#
# Copy to `.env.local` for development. Vercel sets these per environment.
#
# Every variable here is `NEXT_PUBLIC_`, which means Next inlines its value into
# the browser bundle at BUILD time. These are not runtime settings: changing one
# requires a rebuild, and a value that is not a secret is the only kind that
# belongs here. Never put an API secret key in this file — it would be published
# to every visitor.

# Absolute origin of the API, with no trailing slash.
# In production this must be https:// and must not be localhost: a deployed build
# pointed at localhost calls the visitor's own machine, and one served over HTTPS
# cannot call an HTTP API at all because the browser blocks it as mixed content.
# The landing page shows the value this build was compiled against, and warns
# here if it is wrong.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Shown in the header, on receipts and in the browser tab.
NEXT_PUBLIC_APP_NAME=A&B Chemist
