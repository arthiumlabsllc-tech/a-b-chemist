# A&B Chemist API — environment variables.
#
# Copy to `.env` for local development. `.env` is gitignored; this file is not.
# Every variable below is read by `src/config/index.ts`, which is the only place
# `process.env` is touched. A variable that is not listed here is not read.
#
# In production a missing or unsafe value stops the boot rather than being
# defaulted. That is deliberate: a server that starts with a development JWT
# secret hands out tokens anyone can forge.

NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase: use the POOLED connection string (Session mode, port 5432 on the
# `aws-0-<region>.pooler.supabase.com` host). The direct host is IPv6-only and
# will not connect from Render's free tier.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/a_and_b_chemist

# Leave unset to derive from DATABASE_URL: on for a hosted database, off for
# loopback. Supabase requires it on.
# DATABASE_SSL=true

# Set only if the certificate chain cannot be verified. Weakens the connection
# to an unauthenticated one, so it should never be set for a hosted database.
# DATABASE_SSL_ALLOW_INSECURE=false

# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# Milliseconds the readiness probe waits before reporting the database down.
# DATABASE_PROBE_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters, and the two must differ — one
# secret for both turns a stolen access token into a seven-day refresh token.
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_DAYS=7
# BCRYPT_ROUNDS=12

# Comma-separated list of origins the browser client is served from.
# Production requires at least one.
CORS_ORIGIN=http://localhost:3000

# Render terminates TLS and forwards, so this must be on there for `req.ip` to be
# the real client. Defaults to on in production, off elsewhere. Setting it wrong
# puts the whole pharmacy in one rate-limit bucket.
# TRUST_PROXY=true

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Paystack — A&B Chemist's own account
# ---------------------------------------------------------------------------
# Leave both empty until A&B supply keys for their own Paystack account. With no
# keys the API reports the gateway as unconfigured, warns at boot, and the till
# records a mobile money payment as a manual entry instead of charging it. Money
# then settles into A&B's account directly; nothing is split, held or forwarded.
#
# Both must be set or both empty, and both must be from the same environment —
# a test public key against a live secret is rejected, because it produces a
# charge the customer's browser cannot authorise.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of error, warn, info, http, verbose, debug, silly. Defaults to info in
# production and debug elsewhere.
# LOG_LEVEL=info
